{
  "expo": {
    "name": "Mateo Vendedores",
    "slug": "mateo-vendedores",
    "scheme": "mateovendedores",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#DA291C"
    },

    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mateo.vendedores"
    },
    "android": {
      "package": "com.mateo.vendedores",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DA291C"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },

    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}